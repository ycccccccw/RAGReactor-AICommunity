# Database used by the original WebServer features.
MYSQL_USER="root"
MYSQL_PASSWORD="replace_with_database_password"
MYSQL_DATABASE="ycwang"

# Alibaba Cloud Model Studio (Bailian). One key is shared by both models.
BAILIAN_API_KEY="replace_with_bailian_api_key"
BAILIAN_BASE_URL="https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
RAG_EMBEDDING_MODEL="text-embedding-v4"
RAG_LLM_MODEL="qwen-plus"
RAG_RERANK_ENABLED="true"
RAG_RERANK_MODEL="qwen3-rerank"
RAG_RERANK_TOP_N="5"
RAG_RERANK_CANDIDATES="20"
RAG_RERANK_TIMEOUT_MS="10000"
RAG_HNSW_INDEX_PATH="knowledge/index/bailian-v4-1024.hnsw"
RAG_HNSW_M="16"
RAG_HNSW_EF_CONSTRUCTION="200"
RAG_HNSW_EF_SEARCH="50"

# Optional Stage 3 tuning.
RAG_EMBEDDING_DIMENSION="1024"
RAG_MAX_OUTPUT_TOKENS="800"
RAG_MAX_PROMPT_BYTES="12000"
RAG_RELEVANCE_THRESHOLD="0.40"
RAG_DOCUMENT_DIR="knowledge/documents"
RAG_INDEX_PATH="knowledge/index/bailian-v4-1024.ragvec"

# Optional Stage 5 resilience tuning.
RAG_CONNECT_TIMEOUT_MS="3000"
RAG_EMBEDDING_TIMEOUT_MS="10000"
RAG_LLM_TIMEOUT_MS="30000"
RAG_CACHE_CAPACITY="100"
RAG_CACHE_SIMILARITY="0.95"
RAG_CACHE_TTL_SECONDS="600"
RAG_CIRCUIT_FAILURE_THRESHOLD="3"
RAG_CIRCUIT_COOLDOWN_SECONDS="30"
